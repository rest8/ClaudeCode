# ---------- Claude API ----------
# Anthropic Claude API key. Required to generate the personalised report.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- LINE Messaging API (Bot) ----------
# Required only if you deploy the LINE bot at /api/line/webhook
# Get them from LINE Developers > Messaging API channel:
#   https://developers.line.biz/console/
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
