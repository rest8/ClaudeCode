# ============================================================
#  Hermes Monitor 環境変数
#  cp .env.example .env して値を設定してください
# ============================================================

# ---- 通知先 (どちらか一方、または両方を設定) ----
# Google Chat スペース → 設定 → アプリと統合 → Webhook で取得
GOOGLE_CHAT_WEBHOOK=

# LINE Messaging API
# https://developers.line.biz/console/ で Messaging API channel を作成し
# 「Channel access token (long-lived)」を取得
LINE_CHANNEL_TOKEN=
# 通知先の userId / groupId / roomId
# (Bot を友達追加 → Webhook event の source.userId 等から取得)
LINE_TO=

# ---- 巡回設定 ----
# 巡回間隔(秒) — 1にするとブロックされやすいので 30〜60 推奨
HERMES_INTERVAL=30
# Hermes ロケール (jp/ja, fr/fr, us/en, …)
HERMES_LOCALE=jp/ja
# ジッタ率 (0.0-1.0) - 等間隔リクエストを回避
HERMES_JITTER=0.3

# ---- アンチBot対策 (任意) ----
# curl_cffi の TLS 模倣プロファイル
HERMES_IMPERSONATE=chrome124
# プロキシ (カンマ区切り)
# HERMES_PROXIES=user:pass@proxy1.example:8080,user:pass@proxy2.example:8080
HERMES_PROXIES=

# ---- ログ ----
HERMES_LOGLEVEL=INFO
